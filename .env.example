# Hyphy Tools runs with no configuration at all: Demo Mode supplies identity and data.
# Never put secrets in a NEXT_PUBLIC_ variable.

# Which identity source to use: `demo` (default) or `supabase` (not built yet — see docs/AUTH.md).
HYPHY_IDENTITY=demo
# Where data lives: `demo` (default: seed + per-browser journal) or `supabase` (the database below).
HYPHY_DATA=demo

# --- The Hyphy Tools database (HYPHY_DATA=supabase). Server only. ---
# Postgres connection string. On Supabase, use the pooler (transaction mode, port 6543). The app
# runs every query as the person, under Row Level Security; it never uses the service-role key.
# Local: postgres://postgres@localhost:54322/hyphy  (npm run db:local)
DATABASE_URL=
# Connections per server instance (default 8).
DATABASE_POOL_SIZE=
# `on` lets Demo Mode's Reset re-seed the database. Development databases only — Reset also
# refuses on any database without the development marker (supabase/dev/dev_tools.sql).
HYPHY_DEMO_RESET=
# `1` logs every SQL statement.
HYPHY_DB_DEBUG=

# --- Future: Supabase Auth (docs/AUTH.md). Leave empty until sign-in is built. ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
