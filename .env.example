# Hyphy Tools runs with no configuration at all: Demo Mode supplies identity and data.
# Nothing here is required for Phase 1. Never put secrets in a NEXT_PUBLIC_ variable.

# Which identity source to use: `demo` (default) or `supabase` (not built yet — see docs/AUTH.md).
HYPHY_IDENTITY=demo
# Which data repository to use: `demo` (default) or `supabase` (not built yet).
HYPHY_DATA=demo

# --- Future: Supabase (Phase 2). Leave empty until docs/AUTH.md is done. ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Bypasses RLS; only for trusted server code such as webhooks.
SUPABASE_SECRET_KEY=
