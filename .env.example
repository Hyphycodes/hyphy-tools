# Hyphy Tools runs with no configuration at all: Demo Mode supplies identity and data.
# Never put secrets in a NEXT_PUBLIC_ variable.

# Who people are: `demo` (default — no sign-in, Preview As) or `supabase` (real accounts; needs
# HYPHY_DATA=supabase and the Supabase Auth variables below — docs/AUTH.md). Anything other than
# exactly `supabase` means Demo Mode.
HYPHY_IDENTITY=demo
# Where data lives: `demo` (default: seed + per-browser journal) or `supabase` (the database below).
HYPHY_DATA=demo

# --- The Hyphy Tools database (HYPHY_DATA=supabase). Server only. ---
# Postgres connection string for the `hyphy_app` role (supabase/README.md). On Supabase, use the
# transaction pooler, port 6543: postgres://hyphy_app.<project-ref>:<password>@<pooler-host>:6543/postgres
# The app runs every query as the person, under Row Level Security; never use postgres or the
# service-role key here. Local: postgres://hyphy_app@localhost:54322/hyphy  (npm run db:local)
DATABASE_URL=
# Local development only: an administrator connection used to rebuild the local database and by
# the tests that need to remove the development marker.
DATABASE_ADMIN_URL=
# Connections per server instance (default 8).
DATABASE_POOL_SIZE=
# `on` lets Demo Mode's Reset re-seed the database. Development databases only — Reset also
# refuses on any database without the development marker (supabase/dev/dev_tools.sql).
HYPHY_DEMO_RESET=
# `1` logs every SQL statement.
HYPHY_DB_DEBUG=

# --- Supabase Auth (HYPHY_IDENTITY=supabase only; docs/AUTH.md). Not needed for Demo Mode. ---
# The project URL and its PUBLISHABLE key (sb_publishable_…). Public by design; the app refuses a
# secret or service_role key here. Set them at build time too.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The address people use, without the /platform base path (e.g. https://hyphy-studio.com). Links
# in confirmation and reset emails point here. Development falls back to the request's host.
HYPHY_SITE_URL=
